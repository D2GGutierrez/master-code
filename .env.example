# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.

# Base de datos (PostgreSQL)
POSTGRES_USER=mastercode
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=mastercode
POSTGRES_PORT=5432

# admin-api (Django)
POSTGRES_HOST=localhost
DJANGO_SECRET_KEY=cambia-esta-clave-secreta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
