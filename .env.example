# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.

# Base de datos (PostgreSQL)
POSTGRES_USER=mastercode
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=mastercode
POSTGRES_PORT=5432

# admin-api (Django)
POSTGRES_HOST=localhost
DJANGO_SECRET_KEY=cambia-esta-clave-secreta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DOMINIO_INSTITUCIONAL=tecsup.edu.pe
JWT_PRIVATE_KEY="se-genera-con-make-claves-jwt"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES_WEB=30
JWT_REFRESH_DAYS_MOBILE=30
# Días de vigencia del código de invitación de un curso.
INVITACION_DIAS=30
# Clave de la API interna entre admin-api y user-api (D3). Genérala con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=cambia_esta_clave_interna
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=contrasena_de_aplicacion_de_16_letras
DEFAULT_FROM_EMAIL=tu-correo@ejemplo.com
ADMIN_WEB_URL=http://localhost:3000
USER_WEB_URL=http://localhost:3001
# Solo desarrollo: imprime el correo en consola.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# user-api verifica los JWT con la clave pública de admin-api (no son secretos).
JWKS_URI=http://localhost:8000/.well-known/jwks.json
JWT_ISSUER=master-code-admin-api
# Inicio de sesión con Google (docs/inicio-sesion-google.md). Vacío = los botones «Continuar con Google» no se muestran.
# ID de cliente OAuth de tipo «Aplicación web» (termina en .apps.googleusercontent.com). No es secreto.
GOOGLE_CLIENT_ID=
# Correos de docentes que pueden entrar al panel de docentes con Google, separados por coma.
DOCENTES_AUTORIZADOS=
# ai-service: proveedor de LLM (mock, gemini o groq). Con mock no hace falta clave.
LLM_PROVIDER=gemini
# La clave real va solo en tu .env local, nunca aquí.
LLM_API_KEY=
# Opcional. Vacío = gemini-flash-latest (Gemini) o llama-3.3-70b-versatile (Groq).
# Si el proveedor responde 404 o rechaza el modelo, pon aquí uno vigente de su lista de modelos.
LLM_MODEL=

# ai-service: motor que ejecuta el código de los estudiantes (mock, judge0 o piston).
# mock no ejecuta nada: sirve para desarrollar y para el CI sin ningún motor instalado.
SANDBOX_PROVIDER=mock

# admin-api: dónde está ai-service y cuántos segundos se le espera al generar problemas (HU17).
# En Docker la URL la fija docker-compose.yml; estos valores son para correr admin-api fuera de Docker.
AI_SERVICE_URL=http://localhost:8002
AI_SERVICE_TIMEOUT_SEGUNDOS=100

# user-api: ejecuciones de prueba que un estudiante puede hacer por minuto (HU06-T4). Entero mayor que 0.
EJECUCIONES_POR_MINUTO=10

# user-api: partidas entre compañeros (HU57 a HU60). Todos tienen valor por defecto; solo cámbialos para probar.
# Horas que tiene el compañero para aceptar un reto.
PARTIDA_CADUCIDAD_RETO_HORAS=24
# Ejercicios por partida (como máximo; menos si el curso tiene menos) y puntos por acierto.
PARTIDA_EJERCICIOS=5
PARTIDA_PUNTOS_POR_ACIERTO=10
# Segundos sin señal para que el rival aparezca desconectado, y para perder la partida por abandono.
PARTIDA_SEGUNDOS_DESCONECTADO=10
PARTIDA_SEGUNDOS_PARA_VOLVER=30

# user-api: aviso diario de racha en peligro (HU52-T2). Apagado hasta que exista el envío real (Firebase, H5).
AVISOS_TAREA_ACTIVA=false
# Cada cuánto revisa a quién avisar (duración ISO 8601: PT15M = 15 minutos).
AVISOS_INTERVALO=PT15M

# Judge0 (sandbox): base y Redis propios; inventa dos contraseñas distintas en tu .env local.
JUDGE0_DB_PASSWORD=cambia_esta_clave_judge0_db
JUDGE0_REDIS_PASSWORD=cambia_esta_clave_judge0_redis

# SonarQube local (docs/sonarqube.md): token de análisis que creas en http://localhost:9000 (Mi cuenta > Seguridad).
# Se deja vacío aquí: es un secreto de tu PC, no se sube al repositorio.
SONAR_TOKEN=
