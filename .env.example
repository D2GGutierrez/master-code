# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.

# Base de datos (PostgreSQL)
POSTGRES_USER=mastercode
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=mastercode
POSTGRES_PORT=5432

# admin-api (Django)
POSTGRES_HOST=localhost
DJANGO_SECRET_KEY=cambia-esta-clave-secreta
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DOMINIO_INSTITUCIONAL=tecsup.edu.pe
JWT_PRIVATE_KEY="se-genera-con-make-claves-jwt"
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES_WEB=30
JWT_REFRESH_DAYS_MOBILE=30
# Días de vigencia del código de invitación de un curso.
INVITACION_DIAS=30
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=contrasena_de_aplicacion_de_16_letras
DEFAULT_FROM_EMAIL=tu-correo@ejemplo.com
ADMIN_WEB_URL=http://localhost:3000
USER_WEB_URL=http://localhost:3001
# Solo desarrollo: imprime el correo en consola.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# user-api verifica los JWT con la clave pública de admin-api (no son secretos).
JWKS_URI=http://localhost:8000/.well-known/jwks.json
JWT_ISSUER=master-code-admin-api

# ai-service: proveedor de LLM (mock, gemini, github o groq). Con mock no hace falta clave.
LLM_PROVIDER=mock
# La clave real va solo en tu .env local, nunca aquí.
LLM_API_KEY=

# Judge0 (sandbox): base y Redis propios; inventa dos contraseñas distintas en tu .env local.
JUDGE0_DB_PASSWORD=cambia_esta_clave_judge0_db
JUDGE0_REDIS_PASSWORD=cambia_esta_clave_judge0_redis
