<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- El fondo de la ventana es el lienzo de la app, para que al abrir no se vea un fogonazo blanco en el tema oscuro. -->
    <style name="Theme.MasterCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lienzo</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
